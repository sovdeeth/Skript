using script reflection
using error catching

function dfrErrOne(n: number) :: number:
	return {_n}

function dfrErrAmbiguous(n: number) :: text:
	return "number"

function dfrErrAmbiguous(t: text) :: text:
	return "text"

test "running with arguments which do not fit reports why":
	set {_function} to function "dfrErrOne"
	set {_list::*} to 1 and 2

	catch runtime errors:
		run {_function} with arguments {_list::*}

	assert last caught runtime errors is set with "running with unacceptable arguments reported nothing"

test "the result of a call with arguments which do not fit reports why":
	set {_function} to function "dfrErrOne"
	set {_list::*} to 1 and 2

	catch runtime errors:
		set {_result} to result of {_function} with arguments {_list::*}

	assert {_result} is not set with "the call should not have produced a result"
	assert last caught runtime errors is set with "asking for the result of an unacceptable call reported nothing"

test "an ambiguous call reports which overloads matched":
	set {_function} to function "dfrErrAmbiguous"
	set {_unknown} to 1

	catch runtime errors:
		set {_result} to result of {_function} with arguments {_unknown}

	assert {_result} is not set with "an ambiguous call should not have produced a result"
	# the candidates are listed from a set, so only the stable part of the message is checked
	set {_errors::*} to last caught runtime errors
	assert {_errors::1} contains "Cannot determine which function named 'dfrErrAmbiguous' to call" with "an ambiguous call did not report the candidates"
	assert {_errors::1} contains "value within" with "the message should suggest how to disambiguate"

test "a call which fits reports nothing":
	set {_function} to function "dfrErrOne"

	catch runtime errors:
		set {_result} to result of {_function} with arguments 1

	assert {_result} is 1 with "the call should have succeeded"
	assert last caught runtime errors is not set with "a successful call reported an error"
